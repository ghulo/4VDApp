# Headers Cloudflare adds to every page of 4vd.app (Workers static assets read this file).
# The alerts service worker must never be served stale.
/sw.js
  Cache-Control: no-cache

# Browser protection on every page.
# - HSTS without includeSubDomains: api.4vd.app and the mail setup are handled elsewhere.
# - The CSP is Report-Only for now: the browser only reports what it would block (to Sentry's
#   security endpoint), nothing breaks. Once Sentry shows no reports from real use (Google
#   sign-in, camera scanner, photos, push, the Windows app), rename the header to
#   Content-Security-Policy to enforce it.
#   What it allows: Google sign-in (accounts.google.com/gsi), Google Fonts, the API, Sentry,
#   GitHub's releases API (Download page), Cloudflare Web Analytics (its beacon script and reports), the barcode scanner's WebAssembly ('wasm-unsafe-eval'),
#   product photos from any https link, inline styles (per-business colours, charts), and the saved copy's worker
#   (sw.js, worker-src 'self') fetching Google's fonts to keep them (connect-src).
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.4vd.app https://fonts.googleapis.com https://fonts.gstatic.com https://accounts.google.com/gsi/ https://*.ingest.de.sentry.io https://api.github.com https://cloudflareinsights.com; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri https://o4512442566639616.ingest.de.sentry.io/api/4512442586366032/security/?sentry_key=b94dc78b01c1c7c6525f4e24c2cfc27e
