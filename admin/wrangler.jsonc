// Cloudflare Workers (static assets) config for the dashboard: dashboard.4vd.app.
// Cloudflare builds with `npm ci && npm run build`, then `npx wrangler deploy` uploads dist/.
{
  "name": "4vd-dashboard",
  "compatibility_date": "2026-10-01",
  // The address it answers on; Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "dashboard.4vd.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Every page is handled by the app itself, so unknown paths load index.html.
    "not_found_handling": "single-page-application"
  }
}
