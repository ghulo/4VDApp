// Cloudflare Workers (static assets) config for the dashboard: 4vd.app.
// GitHub Actions (.github/workflows/ci.yml, job deploy-dashboard) builds it and runs
// `wrangler deploy` once every check passes on main. Cloudflare's own build only uploads
// versions (deploy command `npx wrangler versions upload`), never puts them live.
{
  "name": "4vd-dashboard",
  "compatibility_date": "2026-10-01",
  // The address it answers on; Cloudflare creates the DNS record and certificate.
  // The old name dashboard.4vd.app was removed on purpose (2026-10-20).
  "routes": [{ "pattern": "4vd.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Every page is handled by the app itself, so unknown paths load index.html.
    "not_found_handling": "single-page-application"
  }
}
