# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/four_vd_app
# Used by the integration tests. They wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/four_vd_app_test

# Auth - use a long random string, never commit the real one.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# First admin account, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# Optional error tracking
SENTRY_DSN=

# Optional web push (PC and browser alerts). Without these, only phone (Expo) push is sent.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if something goes wrong, e.g. mailto:you@example.com
VAPID_SUBJECT=
