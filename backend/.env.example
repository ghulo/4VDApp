# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/four_vd_app
# Used by the integration tests. They wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/four_vd_app_test

# Auth - use a long random string, never commit the real one.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# First admin account, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin

# Optional error tracking
SENTRY_DSN=

# The shop's time zone: busy days of the week in forecasts, and when the daily summary goes out.
SHOP_TIME_ZONE=Europe/Budapest

# Where the dashboard and the employee app live; links in emails point here.
DASHBOARD_URL=http://localhost:5173
TEAM_APP_URL=http://localhost:8081

# Emails (invites, password resets) are printed to the log until this is set.
# Get a key at https://resend.com after adding your domain there.
RESEND_API_KEY=
EMAIL_FROM=4VD <hello@your-domain.com>

# Google sign-in: an OAuth client ID (Web application) from Google Cloud. Off when empty.
GOOGLE_CLIENT_ID=

# Public "create your shop" sign-up. Keep false while 4VD serves one shop.
ALLOW_SIGNUP=false

# Optional AI helpers (Ask page). Claude is used when ANTHROPIC_API_KEY is set, otherwise Gemini.
# Make the key inside a workspace in the Anthropic Console; for a key made outside one, set ANTHROPIC_WORKSPACE_ID too.
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 is good value for questions; claude-haiku-4-5 is cheaper for simple ones.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WORKSPACE_ID=

# Gemini: free key from https://aistudio.google.com (the free tier isn't offered in every country).
# The free tier may use what's sent to improve Google's products; staff names are replaced before sending.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional web push (PC and browser alerts). Without these, only phone (Expo) push is sent.
# Generate them with: npm run vapid -- you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if something goes wrong, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Optional: lets the weekly backup job tell the app it finished (any random 20+ characters; same value as the GitHub secret).
BACKUP_PING_TOKEN=
